
// Select Database
use collegeDB

// Create Collection
db.createCollection("students")

// Insert Records
db.students.insertMany([
    {name: "Surya", age: 20, department: "CSE"},
    {name: "Rahul", age: 21, department: "ECE"},
    {name: "Priya", age: 19, department: "IT"}
])

// Display All Records
db.students.find()

// Display Specific Record
db.students.find({name: "Surya"})

// Update Record
db.students.updateOne(
    {name: "Surya"},
    {$set: {age: 22}}
)

// Display Updated Record
db.students.find()

// Delete Record
db.students.deleteOne({name: "Rahul"})

// Display Remaining Records
db.students.find()

